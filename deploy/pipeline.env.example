# Copy to /srv/quiet-courier/pipeline.env, mode 600, owned by courier.
DATABASE_URL=postgresql://quietcourier:CHANGE_ME@127.0.0.1:5432/quietcourier
EDITIONS_DIR=/srv/quiet-courier/editions
COURIER_DB=/srv/quiet-courier/data/courier.db
COURIER_CONTACT_EMAIL=hello@quietcourier.com
RESEND_API_KEY=
MAIL_FROM=The Quiet Courier <edition@quietcourier.com>
# Resend free plan: 100 a day, 3,000 a month. Raise these if the plan changes.
MAIL_DAILY_LIMIT=100
MAIL_MONTHLY_LIMIT=3000
ALERT_EMAIL=hello@quietcourier.com
# The Conversation's addresses for the daily copy and the monthly report. Kept out of the repo.
PARTNER_COPY_TO=
PARTNER_REPORT_TO=
# Nothing is sent until this is 1.
DELIVERY_ENABLED=0
# Must match the site's BILLING_ENABLED. With 1, the first paper starts the free trial and the paper
# stops when it ends unless the reader has subscribed.
BILLING_ENABLED=0
APP_URL=https://quietcourier.com

<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" lang="en" xml:lang="en">
<head>
<meta charset="utf-8"/>
<title>{{ title }}</title>
<link rel="stylesheet" type="text/css" href="style.css"/>
</head>
<body>
{% macro story(a, drop=true, show_title=true) %}
<article class="story">
  {% if show_title %}<h3>{{ a.title }}</h3>{% endif %}
  {% if a.deck %}<p class="deck">{{ a.deck }}</p>{% endif %}
  {% if a.source_name == "The Conversation" %}<p class="credit">The Conversation</p>{% endif %}
  {% if a.author and a.author != a.source_name %}<p class="byline">By {{ a.author }}</p>{% endif %}
  {% if a.author_affiliation %}<p class="affil">{{ a.author_affiliation }}</p>{% endif %}
  {% for img in a.images %}
  <figure><img src="{{ images[img.path] }}" alt="{{ img.caption }}"/><figcaption>{{ img.caption }}. {{ img.credit }}</figcaption></figure>
  {% endfor %}
  {% for b in a.body %}
    {% if b.kind == "h" %}<h4>{{ b.text }}</h4>
    {% elif b.kind == "label" %}<p class="label">{{ b.text }}</p>
    {% elif b.kind == "note" %}<p class="note">{{ b.text }}</p>
    {% elif loop.first and drop %}<p class="first">{{ b.text }}</p>
    {% else %}<p>{{ b.text }}</p>
    {% endif %}
  {% endfor %}
  <p class="source">{{ a.attribution }}{% if a.license.id.startswith("cc-") %} License: {{ a.license.name }}.{% endif %}{% if a.changes %} {{ a.changes }}{% endif %}</p>
</article>
{% endmacro %}

{% if kind == "front" %}
<header class="masthead">
  <h1 class="nameplate">{{ e.paper_name }}</h1>
  <p class="motto">“{{ e.motto }}”</p>
  <p class="folio">Vol. {{ e.volume | roman }} · No. {{ e.number }} · {{ date_long }} · {{ e.location.name if e.location else "General" }} Edition</p>
  {% if today %}  <p class="weather-line"><b>{{ today.name }}:</b> {{ today.short | sentence }}, {{ "high" if today.is_daytime else "low" }} {{ today.temperature }}°. <b>{{ next_period.name }}:</b> {{ next_period.short | sentence }}, {{ "high" if next_period.is_daytime else "low" }} {{ next_period.temperature }}°.</p>{% endif %}
</header>
<h2 class="lead-headline">{{ e.lead.title }}</h2>
{{ story(e.lead, show_title=false) }}
{% for a in secondaries %}{{ story(a) }}{% endfor %}

{% elif kind == "brief" %}
<h2 class="section-head">The World in Brief<small>{{ e.brief.day | weekday_date }}</small></h2>
{% for i in e.brief.items %}<p class="brief-item">{% if i.topic %}<span class="brief-topic">{{ i.topic }}.</span> {% endif %}{{ i.text }}{% if i.outlets %} <i>({{ i.outlets | join(", ") }})</i>{% endif %}</p>
{% endfor %}
<p class="source">{{ e.brief.attribution }} License: {{ e.brief.license.name }}. {{ e.brief.changes }}</p>

{% elif kind == "section" %}
<h2 class="section-head">{{ section.name }}{% if section.subtitle %}<small>{{ section.subtitle }}</small>{% endif %}</h2>
{% if section.id == "weather" and e.weather %}
<article class="story">
  <h3>The Forecast for {{ e.weather.city }}</h3>
  <div class="centered-block"><table class="forecast">
    {% for p in e.weather.periods %}<tr><th>{{ p.name }}</th><td>{{ p.temperature }}°</td><td>{{ p.short | sentence }}</td></tr>{% endfor %}
  </table></div>
  <p class="first">{{ today.detail }}</p>
  <p class="source">{{ e.weather.attribution }}</p>
</article>
{% endif %}
{% if section.id == "archives" %}
  {% for a in articles %}
  <article class="story archive{% if a.kind == 'advertisement' %} old-ad{% endif %}">
    {% if a.kind == "advertisement" %}<p class="credit">Advertisement, 1926</p>{% endif %}
    <h3>{{ a.title }}</h3>
    {% if a.deck %}<p class="deck">{{ a.deck }}</p>{% endif %}
    {% for b in a.body %}<p>{{ b.text }}</p>{% endfor %}
  </article>
  {% endfor %}
  {% if articles %}<p class="source">{{ articles[0].attribution }}</p>{% endif %}
  <article class="poem">
    <h3>{{ e.poem.title }}</h3>
    <p class="byline">{{ e.poem.author }}, {{ e.poem.year }}</p>
    <div class="centered-block"><div class="poem-lines">
    {% for stanza in e.poem.stanzas %}<div class="stanza">{% for line in stanza %}<p class="line">{{ line }}</p>{% endfor %}</div>{% endfor %}
    </div></div>
    <p class="source">{{ e.poem.attribution }} Text from {{ e.poem.source_name }}.</p>
  </article>
{% else %}
  {% for a in articles %}{{ story(a) }}{% endfor %}
{% endif %}

{% elif kind == "serial" %}
{% set sr = e.serial %}
<h2 class="section-head">The Serial<small>Instalment {{ sr.number }} of {{ sr.total }}</small></h2>
<article class="story serial">
  <h3>{{ sr.title }}</h3>
  <p class="byline">By {{ sr.author }}, {{ sr.year }}</p>
  {% if sr.number == 1 %}<p class="center"><i>Begins today. The next instalment comes with each morning’s paper.</i></p>{% endif %}
  {% set ns = namespace(first=false) %}
  {% for b in sr.blocks %}
    {% if b.kind in ("chapter", "continued") %}
      {% if b.part %}<p class="center serial-part">{{ b.part }}</p>{% endif %}
      <h4>{{ b.text }}{% if b.title %}<br/><i>{{ b.title }}</i>{% endif %}</h4>
      {% if b.kind == "continued" %}<p class="center"><i>Continued from yesterday</i></p>{% endif %}
      {% set ns.first = b.kind == "chapter" %}
    {% elif b.kind == "break" %}<p class="center">* * *</p>
    {% elif b.kind == "note" %}<p class="note">{{ b.text }}</p>
    {% elif ns.first %}<p class="first">{{ b.text }}</p>{% set ns.first = false %}
    {% else %}<p>{{ b.text }}</p>
    {% endif %}
  {% endfor %}
  {% if sr.last %}<p class="center"><b>The End</b></p>{% if sr.next_title %}<p class="center"><i>Tomorrow, the first instalment of {{ sr.next_title }}.</i></p>{% endif %}
  {% else %}<p class="center"><i>To be continued tomorrow.</i></p>{% endif %}
  <p class="source">{{ sr.attribution }}</p>
</article>

{% elif kind == "puzzles" %}
<h2 class="section-head">Sudoku and Cryptogram</h2>
<h3>Sudoku</h3>
<p class="center"><i>{{ sudoku.level }}. Fill the grid so every row, column and three-by-three box holds the numbers 1 to 9 once.</i></p>
<div class="centered-block"><table class="sudoku">
  {% for row in sudoku.grid %}{% set r = loop.index %}<tr>{% for v in row %}<td class="{% if loop.index in (3, 6) %}box-r{% endif %}{% if r in (3, 6) %} box-b{% endif %}">{{ v if v else "" }}</td>{% endfor %}</tr>{% endfor %}
</table></div>
{% if crypt %}
<h3>Cryptogram</h3>
<p class="center"><i>A line of verse by {{ e.quote.author }}, with every letter swapped for another. {{ crypt.hint[0] }} stands for {{ crypt.hint[1] }}.</i></p>
<p class="center crypt">{{ crypt.words | join("   ") }}</p>
{% endif %}

{% elif kind == "sources" %}
<h2 class="section-head">Sources and Licenses</h2>
<ol class="sources">
  {% for a in e.all_sources() %}
  <li><b>{{ a.title }}</b>. {{ a.source_name }}{% if a.author and a.author != a.source_name %}, {{ a.author }}{% endif %}. {{ a.license.name }}{% if a.license.id.startswith("cc-") %} (<a href="{{ a.license.url }}">{{ a.license.url }}</a>){% endif %}. <a href="{{ a.source_url }}">{{ a.source_url }}</a></li>
  {% endfor %}
  {% if e.weather %}<li><b>Weather</b>. {{ e.weather.office }}. {{ e.weather.license_name }}. <a href="{{ e.weather.source_url }}">{{ e.weather.source_url }}</a></li>{% endif %}
  <li><b>{{ e.poem.title }}</b>, {{ e.poem.author }}. {{ e.poem.license.name }}. <a href="{{ e.poem.source_url }}">{{ e.poem.source_url }}</a></li>
  {% if e.quote %}<li><b>Cryptogram</b>. A line from “{{ e.quote.title }},” {{ e.quote.author }}. {{ e.quote.license.name }}. <a href="{{ e.quote.source_url }}">{{ e.quote.source_url }}</a></li>{% endif %}
  {% if e.serial %}<li><b>{{ e.serial.title }}</b>, {{ e.serial.author }} ({{ e.serial.year }}), instalment {{ e.serial.number }}. {{ e.serial.license.name }}.</li>{% endif %}
  {% if e.brief %}<li><b>The World in Brief</b>. Wikipedia contributors, Current events portal. {{ e.brief.license.name }} (<a href="{{ e.brief.license.url }}">{{ e.brief.license.url }}</a>). {{ e.brief.changes }} <a href="{{ e.brief.source_url }}">{{ e.brief.source_url }}</a></li>{% endif %}
</ol>

{% elif kind == "final" %}
<h2 class="section-head">Puzzles</h2>
<h3>Word Search</h3>
<p class="center"><i>Words from today’s poem, “{{ e.poem.title }},” hidden in any of eight directions.</i></p>
<div class="centered-block"><table class="wordsearch">
  {% for row in ws.grid %}<tr>{% for ch in row %}<td>{{ ch }}</td>{% endfor %}</tr>{% endfor %}
</table></div>
<p class="center wordlist">{{ ws.words | join(" · ") }}</p>
<h3>The Almanac</h3>
{% if e.location %}<p class="center"><i>{{ e.location.name }}, {{ e.location.region }}</i></p>
<p class="center">Sunrise {{ alm.sunrise | clock }} · Sunset {{ alm.sunset | clock }}<br/>
{% if alm.daylight %}Daylight {{ alm.daylight.seconds // 3600 }} h {{ (alm.daylight.seconds % 3600) // 60 }} min<br/>{% endif %}
Moon: {{ alm.moon_phase }}. Moonrise {{ alm.moonrise | clock }}, moonset {{ alm.moonset | clock }}<br/>
{% else %}<p class="center">Moon: {{ alm.moon_phase }}<br/>
{% endif %}Day {{ alm.day_of_year }} of the year. {{ alm.days_remaining }} days remain.</p>
<div class="the-end">
  <p class="end-words">That’s all for today.</p>
  <p class="center"><i>The next edition arrives tomorrow morning.</i></p>
  <p class="center">-30-</p>
</div>
{% endif %}
</body>
</html>
